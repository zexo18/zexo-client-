// wrangler.jsonc: ZEXO, stage 2 (D1 + R2 connected)
{
  "name": "zexo",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zexo-db",
      "database_id": "59b3220b-370e-4118-8b6e-dd8de6a5ca4b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "zexo-files" }],
  // Secrets (never put these in this file). Set with: npx wrangler secret put ADMIN_SETUP_TOKEN
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
